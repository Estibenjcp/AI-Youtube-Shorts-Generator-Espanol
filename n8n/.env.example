# Copia esto a n8n/.env y rellena los dos valores. Ninguno pasa por el chat.

# El subdominio que apuntaste en Cloudflare y que vas a dar de alta en NPM.
N8N_HOST=n8n.tudominio.com

# Generala tu mismo en el servidor con: openssl rand -hex 32
# No la pierdas: si cambia, n8n ya no puede leer las credenciales guardadas
# (el token de Telegram, y mas adelante el de YouTube).
N8N_ENCRYPTION_KEY=

TZ=America/Bogota
